generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum PhotoSlot {
  PREP
  GOAL
  NOTES
  ASSIGNMENT
}

model Post {
  id          String     @id @default(cuid())
  studentId   String?
  student     Student?   @relation(fields: [studentId], references: [id], onDelete: SetNull)
  authorName  String
  authorRole  String
  avatarUrl   String?
  lessonTitle String
  caption     String
  transcript  String     @default("")
  createdAt   DateTime   @default(now())
  comments    Comment[]
  photos      PostPhoto[]
}

model PostPhoto {
  id        String    @id @default(cuid())
  postId    String
  slot      PhotoSlot
  label     String
  imageUrl  String
  createdAt DateTime  @default(now())
  post      Post      @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([postId, slot])
}

model Comment {
  id         String   @id @default(cuid())
  postId      String
  authorName String
  body       String
  createdAt  DateTime @default(now())
  post       Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
}

model ScheduleItem {
  id          String   @id @default(cuid())
  title       String
  notes       String?
  scheduledFor DateTime
  createdAt   DateTime @default(now())
}

model Team {
  id       String    @id @default(cuid())
  name     String    @unique
  emblem   String
  students Student[]
}

model Student {
  id        String         @id @default(cuid())
  name      String
  hairKey   String
  isMe      Boolean        @default(false)
  joinedOn  String         @default("2000-01-01")
  teamId    String
  team      Team           @relation(fields: [teamId], references: [id], onDelete: Cascade)
  promises  DailyPromise[]
  purchases Purchase[]
  posts     Post[]
  quests    Quest[]
  /// 대결장 레이팅 (기본 1000)
  rating    Int            @default(1000)
  /// 쓰고 있는 모자와 함께 다니는 펫 (없으면 비어 있음)
  hatKey    String?
  petKey    String?
  duelsChallenged Duel[]   @relation("DuelChallenger")
  duelsReceived   Duel[]   @relation("DuelOpponent")
  bossRewards     BossReward[]
  achievements    Achievement[]
}

/// 약속 카드. scope=DAY 는 하루 카드(slotIndex 0~2 가 점수에 들어감), scope=WEEK 는 주간 퀘스트 카드(dateKey 가 그 주 월요일).
model DailyPromise {
  id           String        @id @default(cuid())
  studentId    String
  dateKey      String
  slotIndex    Int
  subject      String
  title        String
  unitKind     String
  unitStart    Int
  unitCount    Int
  scope        String        @default("DAY")
  questId      String?
  requireProof Boolean       @default(false)
  reviewStatus String        @default("NONE")
  feedback     String        @default("")
  submittedAt  DateTime?
  reviewedAt   DateTime?
  reviewedBy   String        @default("")
  createdAt    DateTime      @default(now())
  student      Student       @relation(fields: [studentId], references: [id], onDelete: Cascade)
  quest        Quest?        @relation(fields: [questId], references: [id], onDelete: SetNull)
  units        PromiseUnit[]
  proofs       QuestProof[]

  @@unique([studentId, dateKey, slotIndex])
  @@index([dateKey])
}

model PromiseUnit {
  id          String       @id @default(cuid())
  promiseId   String
  unitNo      Int
  confirmedAt DateTime     @default(now())
  promise     DailyPromise @relation(fields: [promiseId], references: [id], onDelete: Cascade)

  @@unique([promiseId, unitNo])
}

model Purchase {
  id        String   @id @default(cuid())
  studentId String
  itemKey   String
  cost      Int
  createdAt DateTime @default(now())
  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([studentId, itemKey])
}

/// 교사가 학생 한 명에게 내는 퀘스트. kind=DAILY 는 요일마다 반복, kind=WEEKLY 는 한 주 목표.
model Quest {
  id           String         @id @default(cuid())
  studentId    String
  kind         String
  subject      String
  title        String
  note         String         @default("")
  unitKind     String
  unitStart    Int            @default(1)
  unitCount    Int
  advance      Boolean        @default(false)
  weekdays     String         @default("12345")
  startDate    String
  endDate      String?
  requireProof Boolean        @default(false)
  active       Boolean        @default(true)
  createdBy    String         @default("선생님")
  createdAt    DateTime       @default(now())
  student      Student        @relation(fields: [studentId], references: [id], onDelete: Cascade)
  cards        DailyPromise[]

  @@index([studentId])
}

/// 학생이 찍어 올린 인증 사진. imageUrl 은 상대 경로(/uploads/… 또는 /api/uploads/…)다.
model QuestProof {
  id        String       @id @default(cuid())
  promiseId String
  imageUrl  String
  createdAt DateTime     @default(now())
  promise   DailyPromise @relation(fields: [promiseId], references: [id], onDelete: Cascade)

  @@index([promiseId])
}

/// UPLOAD_STORAGE=db 일 때 사진 본문을 담는 곳(서버리스 배포용).
model UploadedFile {
  id        String   @id @default(cuid())
  mime      String
  size      Int
  data      Bytes
  createdAt DateTime @default(now())
}

/// 친구와 같은 문제 5개를 각자 풀어 겨루는 비동기 퀴즈 대결. questions 는 정답 위치가 든 JSON 이라 화면에는 정답 없이 보낸다.
model Duel {
  id                    String    @id @default(cuid())
  challengerId          String
  opponentId            String
  category              String
  questions             String
  /// CHALLENGER_TURN(도전자가 푸는 중) | PENDING(상대를 기다림) | DONE | DECLINED | EXPIRED
  status                String    @default("CHALLENGER_TURN")
  dateKey               String
  challengerAnswers     String?
  challengerCorrect     Int?
  challengerScore       Int?
  challengerMs          Int?
  opponentStartedAt     DateTime?
  opponentAnswers       String?
  opponentCorrect       Int?
  opponentScore         Int?
  opponentMs            Int?
  /// 도전자 기준 WIN | LOSE | DRAW
  outcome               String?
  ratingDelta           Int       @default(0)
  challengerRatingAfter Int?
  opponentRatingAfter   Int?
  challengerXp          Int       @default(0)
  challengerCoins       Int       @default(0)
  opponentXp            Int       @default(0)
  opponentCoins         Int       @default(0)
  finishedKey           String?
  /// 끝난 뒤 서로에게 보낸 응원 이모트 (EMOTE_NAMES 중 하나)
  challengerEmote       String?
  opponentEmote         String?
  createdAt             DateTime  @default(now())
  finishedAt            DateTime?
  challenger            Student   @relation("DuelChallenger", fields: [challengerId], references: [id], onDelete: Cascade)
  opponent              Student   @relation("DuelOpponent", fields: [opponentId], references: [id], onDelete: Cascade)

  @@index([challengerId])
  @@index([opponentId])
  @@index([status])
  @@index([finishedKey])
}

/// 학급 보스를 쓰러뜨린 주에 학생이 한 번씩 받는 보상. (학생, 주) 조합은 하나뿐이다.
model BossReward {
  id        String   @id @default(cuid())
  studentId String
  weekKey   String
  xp        Int
  coins     Int
  claimedAt DateTime @default(now())
  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([studentId, weekKey])
}

/// 학생이 이룬 업적. (학생, 업적 이름) 조합은 하나뿐이라 몇 번을 확인해도 한 번만 남는다.
model Achievement {
  id         String   @id @default(cuid())
  studentId  String
  key        String
  unlockedAt DateTime @default(now())
  /// 알림으로 알려 주었는지
  seen       Boolean  @default(false)
  student    Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([studentId, key])
}

/// 학급 전체에 적용되는 켜고 끄는 설정 (예: 대결장 열기).
model ClassSetting {
  key   String @id
  value String
}
