# 로컬 개발용 SQLite (없어도 이 값이 기본으로 쓰입니다)
DATABASE_URL="file:./dev.db"

# 교사 입장 PIN. 개발 환경에서는 없으면 1234, 운영(production)에서는 꼭 정해야 교사 입장이 열립니다.
# TEACHER_PIN="여기에-PIN"

# 로그인 쿠키 서명용 비밀값. 없으면 DATABASE_URL에서 파생합니다.
# SESSION_SECRET="아무-긴-문자열"

# 사진 저장 위치: local(기본, public/uploads) 또는 db(서버리스 배포용, 데이터베이스에 저장)
# UPLOAD_STORAGE="db"
